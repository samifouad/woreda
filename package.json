{
  "name": "woreda",
  "version": "6.0.0",
  "description": "GitHub Actions self-hosting: set up, monitor and manage runners over SSH.",
  "type": "module",
  "module": "src/woreda.ts",
  "bin": {
    "woreda": "src/woreda.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun src/woreda.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-all.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "inquirer": "14.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samifouad/woreda.git"
  },
  "author": "Sami Fouad",
  "license": "Apache-2.0",
  "files": [
    "src/",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/samifouad/woreda",
  "keywords": [
    "github-actions",
    "self-hosted",
    "runners",
    "cli"
  ]
}
